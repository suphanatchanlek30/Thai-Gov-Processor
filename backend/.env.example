PORT=8080
MAX_UPLOAD_MB=15
PRESIGN_TTL_SECONDS=3600

# MinIO run via docker-compose (see repo root docker-compose.yml).
# Run this service with `go run ./cmd/api` while `docker compose up minio createbuckets`
# is running, so the backend reaches MinIO on the host-published port.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=thai-gov-processor
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
