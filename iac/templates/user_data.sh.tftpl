#!/bin/bash
set -euo pipefail

# Baked in at apply time (see ec2.tf for why) instead of querying instance
# metadata after boot.
echo "${elastic_ip}" > /etc/thai-gov-processor-eip

# cloud-init starts seconds after boot, before Terraform has attached the
# Elastic IP; the subnet's auto-assigned public IP is then swapped for the
# EIP mid-script, which can drop an in-flight download. Retry each step
# until the network has settled rather than letting `set -e` kill the boot.
retry() {
  until "$@"; do
    echo "retrying in 5s: $*" >&2
    sleep 5
  done
}

# ECR auth tokens expire after 12h, so a static image-pull secret would
# start failing with ImagePullBackOff overnight. Instead kubelet runs this
# binary on every pull of an ECR image and gets a fresh token using the
# instance's IAM role. K3s looks for both paths below by default, but only
# enables the feature if they exist when K3s starts - so this must run
# before the installer.
CRED_DIR=/var/lib/rancher/credentialprovider
mkdir -p "$CRED_DIR/bin"
retry curl -sfL "${ecr_provider_url}" -o "$CRED_DIR/bin/ecr-credential-provider"
echo "${ecr_provider_sha256}  $CRED_DIR/bin/ecr-credential-provider" | sha256sum -c -
chmod 755 "$CRED_DIR/bin/ecr-credential-provider"

cat > "$CRED_DIR/config.yaml" <<'EOF'
apiVersion: kubelet.config.k8s.io/v1
kind: CredentialProviderConfig
providers:
  - name: ecr-credential-provider
    matchImages:
      - "*.dkr.ecr.*.amazonaws.com"
    defaultCacheDuration: "12h"
    apiVersion: credentialprovider.kubelet.k8s.io/v1
    args:
      - get-credentials
EOF

retry curl -sfL https://get.k3s.io -o /tmp/k3s-install.sh

# --tls-san adds the Elastic IP to the API server's certificate. Without it
# kubectl from the admin machine fails with "certificate is valid for
# 10.x.x.x, not <eip>" - the cert is otherwise only issued for the
# instance's private IP and localhost.
retry env INSTALL_K3S_VERSION="${k3s_version}" \
  sh /tmp/k3s-install.sh server \
    --tls-san "${elastic_ip}" \
    --node-external-ip "${elastic_ip}"
